# OpenAI: chat for the agent board (embeddings default to local BAAI/bge-m3 — see below)
OPENAI_API_KEY=sk-...
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBED_MODEL=text-embedding-3-large

# Embeddings: "bge" (default) runs BAAI/bge-m3 locally, no API key/cost, and is
# trained/evaluated for Bangla dense retrieval — needed since the statute is Bangla.
# Set to "openai" to use OPENAI_EMBED_MODEL instead (kept for A/B comparison).
EMBEDDING_PROVIDER=bge
BGE_MODEL_NAME=BAAI/bge-m3

# Gemini: PDF OCR only (vision transcription of the scanned/legacy-font statute pages)
GEMINI_API_KEY=...
GEMINI_OCR_MODEL=gemini-3-flash-preview

# Milvus (StatuteGraph substrate) — Milvus Lite local file, no server needed
# NOTE: deliberately NOT named MILVUS_URI — pymilvus itself reads that exact
# env var (via its own internal load_dotenv()) as a legacy network connection
# default and crashes trying to parse a local file path as "host:port".
STATUTEGRAPH_MILVUS_DB_PATH=./data/milvus_statutegraph.db
STATUTEGRAPH_MILVUS_COLLECTION=statutegraph

# Statute version pin (stamped onto every chunk)
STATUTE_VERSION=BLA-2006-amended
